{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"printWidth": 100,
	"endOfLine": "lf",
	"sortPackageJson": false,
	"ignorePatterns": [
		"dist/",
		"public/opensv/",
		"public/borders.json",
		"src-tauri/target/",
		"test/fixtures/",
		"test/perf/results/",
		"test/logs/",
		"src/bindings.gen.ts",
		"src/bindings.consts.ts",
		"src/components/manual/manual-img-dims.gen.ts",
		"src/components/manual/manual-index.gen.ts",
		"src/components/manual/chapters/"
	]
}
