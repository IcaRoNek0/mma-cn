{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "MMA-CN",
	"version": "0.8.3",
	"identifier": "fun.tuxun.mmacn",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run gen:plugin-types && npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "MMA-CN",
				"width": 1400,
				"height": 900,
				"resizable": true,
				"fullscreen": false,
				"visible": true,
				"zoomHotkeysEnabled": true,
				"backgroundColor": "#252521"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"createUpdaterArtifacts": false,
		"resources": {
			"resources/tencent-lines.pmtiles": "tencent-lines.pmtiles"
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"languages": ["SimpChinese", "English"],
				"compression": "lzma"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
